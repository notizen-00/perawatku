# Compose-level configuration for deploy/docker-compose.prod.yml.
# Copy to deploy/.env and fill in the blanks on the server.
#
# This is separate from apps/backend/.env and apps/admin-dashboard/.env
# (the apps' own runtime config) -- these values only control the `db`
# container's bootstrap and the ports published on the host. The Postgres
# values below MUST match DB_DATABASE / DB_USERNAME / DB_PASSWORD in
# apps/backend/.env, since that's how Laravel authenticates to this db.

# --- Host ports (fronted by your host reverse proxy / Nginx Proxy Manager) ---
BACKEND_HTTP_PORT=8081
ADMIN_HTTP_PORT=3000

# --- PostgreSQL bootstrap (must match apps/backend/.env DB_* values) ---
POSTGRES_DB=medic_app
POSTGRES_USER=medic
POSTGRES_PASSWORD=change-me

# --- Redis (must match apps/backend/.env REDIS_PASSWORD) ---
REDIS_PASSWORD=change-me
