# Laravel runtime env for the production Docker stack (deploy/docker-compose.prod.yml).
#
# Copy this file to apps/backend/.env on the server and fill in the blanks.
# Unlike .env.production (host names assume DB/Redis running on the bare
# metal host), this file points at the `db`/`redis`/`reverb` service names
# so it works with the Docker Compose network.
#
# This file is loaded through docker-compose's `env_file:`, not Laravel's
# own Dotenv parser (there is no .env file inside the container -- see
# Dockerfile.prod/entrypoint.prod.sh) -- so unlike a normal Laravel .env,
# "${OTHER_VAR}" cross-references are NOT expanded here. Every value below
# is spelled out literally; keep it that way when you edit it.

APP_NAME="Medic App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://backend.perawatku.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true

# Must match POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD in deploy/.env
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=medic_app
DB_USERNAME=medic
DB_PASSWORD=change-me

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=redis

# Must match REDIS_PASSWORD in deploy/.env
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@perawatku.tech"
MAIL_FROM_NAME="Medic App"

# Reverb (WebSocket broadcasting). Inside the compose network the app/nginx
# containers reach Reverb via the `reverb` service name; the browser reaches
# it through Nginx's /app + /apps/ proxy (see docker/nginx/default.conf and
# docker/nginx/reverb-production-proxy.conf.example for the host reverse proxy).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=medic-app
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_ALLOWED_ORIGINS=https://backend.perawatku.tech
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# These VITE_* values only matter if you touch resources/views/welcome.blade.php
# (the only view using @vite) -- they're compiled into the JS bundle at
# image build time (`npm run build` in Dockerfile.prod), not read at
# container runtime, so editing them here has no effect after the image is
# already built. VITE_REVERB_APP_KEY must equal REVERB_APP_KEY above.
VITE_APP_NAME="Medic App"
VITE_REVERB_APP_KEY=change-me
VITE_REVERB_HOST=backend.perawatku.tech
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true
MIDTRANS_FINISH_URL=
MIDTRANS_UNFINISH_URL=
MIDTRANS_ERROR_URL=
